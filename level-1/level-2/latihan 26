Stream<int> hitung() async* {
  for (int i = 1; i <= 5; i++) {
    await Future.delayed(Duration(seconds: 1));
    yield i;
  }
}

Future<void> main() async {
  print('Pengujian Stream Dasar ');
  print('Memulai penerimaan data dari Stream...\n');

  await for (final nilai in hitung()) {
    print('Menerima angka: $nilai');
  }

  print('\nStream selesai.');
}
